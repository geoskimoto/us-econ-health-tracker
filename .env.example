# ─── Django ───────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=econ-tracker.3rdplaces.io,econ-tracker.restore-trust.com,localhost,127.0.0.1

# ─── SSO (apps_auth) ──────────────────────────────────────────────────────────
# JWT_SECRET must byte-match the restore-trust.com portal's secret, or every
# cookie will fail validation.
JWT_SECRET=
AUTH_REQUIRED_GROUP=
COOKIE_DOMAIN=
AUTH_PORTAL_URL=
AUTH_LOGIN_URL=

# ─── FRED API (free at https://fred.stlouisfed.org/docs/api/api_key.html) ────
FRED_API_KEY=your-fred-api-key-here

# ─── Anthropic (Claude Haiku daily analysis) ──────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key-here
