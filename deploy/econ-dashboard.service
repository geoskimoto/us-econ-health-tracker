[Unit]
Description=US Economy Tracker (Django/Daphne)
After=network.target

[Service]
Type=simple
User=geoskimoto
Group=geoskimoto
WorkingDirectory=/home/geoskimoto/projects/economy_tracker
EnvironmentFile=/home/geoskimoto/projects/economy_tracker/.env
ExecStart=/home/geoskimoto/projects/economy_tracker/venv/bin/daphne \
    --bind 127.0.0.1 \
    --port 8095 \
    config.asgi:application
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
